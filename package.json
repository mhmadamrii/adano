{
  "name": "ai-apps",
  "private": true,
  "scripts": {
    "dev:adano": "pnpm --filter adano dev",
    "dev:adano-api": "cd apps/adano-api && .venv/bin/uvicorn app.main:app --port 8000 --reload",
    "build:adano": "pnpm --filter adano build",
    "test:adano-api": "cd apps/adano-api && .venv/bin/python -m pytest -q",
    "dev:fraudless-api": "cd apps/fraudless-api && .venv/bin/uvicorn fraudless.api.main:app --port 8001 --reload",
    "train:fraudless": "cd apps/fraudless-api && .venv/bin/python -m fraudless.training.train --version v1",
    "test:fraudless-api": "cd apps/fraudless-api && .venv/bin/python -m pytest -q",
    "image:fraudless-api": "cd apps/fraudless-api && podman build -t fraudless-api:phase1 -f Containerfile .",
    "dev:fraudless": "pnpm --filter fraudless dev",
    "build:fraudless": "pnpm --filter fraudless build"
  }
}
